+ src/3rdparty/PhysX/include/foundation/PxMath.h | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/src/3rdparty/PhysX/include/foundation/PxMath.h b/src/3rdparty/PhysX/include/foundation/PxMath.h
+--- a/src/3rdparty/PhysX/include/foundation/PxMath.h
++++ b/src/3rdparty/PhysX/include/foundation/PxMath.h
+@@ -19,7 +19,7 @@
+ #pragma warning(pop)
+ #endif
+ 
+-#if (PX_LINUX_FAMILY && PX_INTEL_FAMILY && !PX_EMSCRIPTEN && defined(__GLIBC__))
++#if (PX_LINUX_FAMILY && PX_X64 && defined(__GLIBC__))
+ // Force linking against nothing newer than glibc v2.17 to remain compatible with platforms with older glibc versions
+ __asm__(".symver expf,expf@GLIBC_2.2.5");
