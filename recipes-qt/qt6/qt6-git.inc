SRC_URI = "${QT_GIT}/${QT_GIT_PROJECT}/${QT_MODULE_REPO};name=${QT_MODULE};${QT_MODULE_BRANCH_PARAM};protocol=${QT_GIT_PROTOCOL}"

CVE_PRODUCT ?= "qt:${BPN} qt:qt"

S = "${WORKDIR}/git"

PV = "${QT_VERSION}"

